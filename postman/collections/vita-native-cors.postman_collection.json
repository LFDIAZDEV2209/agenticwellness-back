{
  "info": {
    "name": "Vita — CORS del chat nativo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Regresión pública sin credenciales ni datos de pacientes: preflight de iOS/Android, rechazo de terceros y autenticación intacta. No prueba generación ni micrófono."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://erp.coppadresd.com"
    }
  ],
  "item": [
    {
      "name": "OPTIONS capacitor://localhost",
      "request": {
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "capacitor://localhost"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "POST"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "authorization,content-type"
          }
        ],
        "url": "{{baseUrl}}/api/v1/chat/stream"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Preflight responde 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Origen exacto autorizado\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"capacitor://localhost\"));",
              "pm.test(\"POST autorizado\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"POST\"));",
              "pm.test(\"Authorization y JSON autorizados\", () => { const h = pm.response.headers.get(\"Access-Control-Allow-Headers\").toLowerCase(); pm.expect(h).to.include(\"authorization\"); pm.expect(h).to.include(\"content-type\"); });"
            ]
          }
        }
      ]
    },
    {
